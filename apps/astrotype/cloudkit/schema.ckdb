DEFINE SCHEMA

    // One recorded word: the sample's JSON (see SAMPLES.md) plus a few
    // fields for filtering. The record name is the sample's ID.
    RECORD TYPE Sample (
        "___createTime" TIMESTAMP SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        json            STRING,
        label           STRING QUERYABLE,
        labelSource     STRING,
        version         INT64,
        writer          STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // The keyboard's learned words and settings, one record per iCloud account in
    // the private database (AstrotypeCore `CloudKitSync`): the snapshot's JSON and
    // when it was last written. Never queried, only fetched by name.
    RECORD TYPE KeyboardData (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        changed         TIMESTAMP,
        json            STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
