#include "../../../../config/ios/App.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.tinypenguin.astrotype
MARKETING_VERSION = 0.2.0
INFOPLIST_KEY_CFBundleDisplayName = Astrotype
INFOPLIST_FILE = Config/Info.plist
CODE_SIGN_ENTITLEMENTS = Config/Astrotype.entitlements

// The app loads the model by URL through AstrotypeKit; no generated class.
COREML_CODEGEN_LANGUAGE = None

// Sentry (crash reports and metrics, see docs/telemetry.md). Empty means Sentry stays
// off. CI looks up the real DSN and passes it when it archives for TestFlight. To send
// events from a local build, put the DSN in Config/Secrets.xcconfig (gitignored),
// writing "https:/$()/" instead of "https://" because xcconfig treats "//" as a comment.
SENTRY_DSN =
#include? "Secrets.xcconfig"
