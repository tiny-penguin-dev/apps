#include "../../../../config/ios/Project.xcconfig"

// The keyboard extension (BUILD.md "Architecture"). Its version must match the app's.
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.tinypenguin.astrotype.keyboard
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 1
INFOPLIST_FILE = Config/AstrotypeKeyboard-Info.plist
CODE_SIGN_ENTITLEMENTS = Config/AstrotypeKeyboard.entitlements
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Astrotype
TARGETED_DEVICE_FAMILY = 1
SKIP_INSTALL = YES
SWIFT_EMIT_LOC_STRINGS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks

// Sentry, for the keyboard's crash reports only (KeyboardTelemetry.swift). Empty means
// off; CI passes the app's DSN when it archives. See Astrotype.xcconfig for local builds.
SENTRY_DSN =
#include? "Secrets.xcconfig"
