#include "../../../../config/ios/Project.xcconfig"

// The widget extension: draws Astrotype's Live Activities (for now only the throwaway
// dictation test's). Its version must match the app's.
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.tinypenguin.astrotype.live
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 1
INFOPLIST_FILE = Config/AstrotypeLive-Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Astrotype
TARGETED_DEVICE_FAMILY = 1
SKIP_INSTALL = YES
SWIFT_EMIT_LOC_STRINGS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
