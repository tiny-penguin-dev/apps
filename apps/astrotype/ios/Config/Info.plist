<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Show Documents/Samples in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- astrotype://settings: the keyboard's "Open Astrotype" opens the app on Settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tinypenguin.astrotype</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>astrotype</string>
			</array>
		</dict>
	</array>
	<!-- Sentry DSN, filled in at build time. See docs/telemetry.md. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<!-- Throwaway dictation test (Astrotype/DictationTest): record in the background. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Astrotype is testing dictation: it records a few seconds to check the microphone works, and keeps nothing.</string>
	<!-- Throwaway dictation test: its Live Activity (drawn by AstrotypeLive). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
