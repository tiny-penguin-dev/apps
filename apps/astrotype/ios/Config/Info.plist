<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Show Documents/Samples in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- astrotype://settings: the keyboard's "Open Astrotype" opens the app on Settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tinypenguin.astrotype</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>astrotype</string>
			</array>
		</dict>
	</array>
	<!-- Sentry DSN, filled in at build time. See docs/telemetry.md. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>NSGKFriendListUsageDescription</key>
	<string>Astrotype shows your Game Center friends who use it on the Friends leaderboard.</string>
	<!-- Dictation (features/dictation): the app listens for the keyboard, on the phone,
	     and keeps the mic on in the background for a few minutes after. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Astrotype needs the mic to hear you. It listens only while you dictate, on your phone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Astrotype turns what you say into text on your phone. Nothing is sent or kept.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
