<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Most keys come from the xcconfig (GENERATE_INFOPLIST_FILE). This file adds the rest. -->
	<!-- Sentry DSN, filled in at build time. See docs/telemetry.md. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<!-- AlarmKit asks for permission with this text. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Squawk rings on your lock screen, even on silent or in Focus.</string>
	<!-- Wake-up checks. -->
	<key>NFCReaderUsageDescription</key>
	<string>Squawk reads your wake-up tag to turn off the alarm.</string>
	<key>NSCameraUsageDescription</key>
	<string>Squawk scans your wake-up code to turn off the alarm.</string>
	<!-- Wake-up steps: lights and scenes from the Home app. -->
	<key>NSHomeKitUsageDescription</key>
	<string>Squawk turns on lights, runs scenes and opens blinds as part of your alarms.</string>
	<!-- Morning summary: weather for your rough location, and today's first event. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Squawk shows today's weather on Good morning. Your rough location is enough.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Squawk shows your first event of the day on Good morning. It never changes your calendar.</string>
	<!-- Needed to read ISO 14443 tags (most NFC stickers). Squawk only reads the tag's id. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>D2760000850101</string>
	</array>
</dict>
</plist>
