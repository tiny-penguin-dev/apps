<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Most keys come from the xcconfig (GENERATE_INFOPLIST_FILE). This file adds the rest. -->
	<!-- Sentry DSN, filled in at build time. See docs/telemetry.md. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<!-- AlarmKit asks for permission with this text. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Squawk rings on your lock screen, even on silent or in Focus.</string>
</dict>
</plist>
