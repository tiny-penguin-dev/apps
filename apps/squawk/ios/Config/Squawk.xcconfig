#include "../../../../config/ios/Project.xcconfig"
#include "../../../../config/ios/App.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.tinypenguin.squawk
#include "Version.xcconfig"
INFOPLIST_KEY_CFBundleDisplayName = Squawk
INFOPLIST_FILE = Config/Info.plist
// NFC tag reading, for the "scan a tag" wake-up check.
CODE_SIGN_ENTITLEMENTS = Config/Squawk.entitlements

// Sentry (crash reports and metrics, see docs/telemetry.md). Empty means Sentry stays
// off. CI passes the real DSN from the SENTRY_DSN_SQUAWK secret when it archives for
// TestFlight. To send events from a local build, put the DSN in Config/Secrets.xcconfig
// (gitignored), writing "https:/$()/" instead of "https://" because xcconfig treats
// "//" as a comment.
SENTRY_DSN =
#include? "Secrets.xcconfig"

// AlarmKit needs iOS 26.
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Pro app icons (Pro/AppIcons.swift). Each is an .appiconset in Assets.xcassets.
ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = AppIcon-Night AppIcon-Mint AppIcon-Ice
